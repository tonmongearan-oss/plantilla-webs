# ============================================================
#  Postural · variables de entorno
#  Copia este fichero a .env y rellena los valores.
#  NUNCA subas el .env a git ni lo compartas: contiene secretos.
# ============================================================

# --- General ---
# Cliente: carpeta sitios/<SITE> con su sitio.json
SITE=
# (opcional) esquema propio en la base de datos, para que varios clientes compartan una
DATABASE_SCHEMA=
NODE_ENV=production
# Dominio público (sin https://), lo usa Caddy para el certificado
DOMAIN=www.tudominio.es
# Otras direcciones que redirigen a DOMAIN, separadas por espacios (déjalo vacío si no hay).
# Con www en DOMAIN, pon aquí el dominio sin www. Para un subdominio de demo, déjalo vacío.
ALIAS_DOMAINS=tudominio.es
ACME_EMAIL=tu-correo@tudominio.es
# URL pública completa de la web (con https://)
PUBLIC_BASE_URL=https://www.tudominio.es
CENTER_TIMEZONE=Europe/Madrid
DEFAULT_COUNTRY_CODE=34
LOG_LEVEL=info

# Clave para cifrar los tokens guardados (Google, enlaces de gestión).
# Genérala con:  openssl rand -base64 32
# Si la cambias, habrá que reconectar las cuentas de Google.
ENCRYPTION_KEY=

# Duración de la sesión del panel (horas)
SESSION_TTL_HOURS=12

# --- Base de datos ---
POSTGRES_USER=postural
# Genera una contraseña larga:  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=postural
# Debe coincidir con los tres valores anteriores (host «db» = contenedor de PostgreSQL)
DATABASE_URL=postgres://postural:CAMBIA_ESTA_CONTRASEÑA@db:5432/postural

# --- Google Calendar (ver docs/GOOGLE_CALENDAR.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe estar registrada tal cual en Google Cloud
GOOGLE_REDIRECT_URI=https://www.tudominio.es/api/admin/google/callback
# false = si Google no responde, no se aceptan reservas (evita duplicados). true = se aceptan igualmente.
GOOGLE_BUSY_FAIL_OPEN=false

# --- WhatsApp (ver docs/WHATSAPP.md) ---
# meta = WhatsApp Business Platform (Cloud API) · twilio = Twilio · disabled = sin mensajes
WHATSAPP_PROVIDER=disabled
WA_TEMPLATE_LANG=es
WA_TPL_CONFIRMATION=postural_cita_confirmada
WA_TPL_REMINDER=postural_recordatorio_cita
WA_TPL_CANCELLED=postural_cita_cancelada
WA_TPL_RESCHEDULED=postural_cita_modificada

# Meta (WhatsApp Cloud API)
META_WA_API_VERSION=v21.0
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=
# Texto que inventas tú y pegas también en la configuración del webhook de Meta
META_WA_VERIFY_TOKEN=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+34XXXXXXXXX
TWILIO_CONTENT_SID_CONFIRMATION=
TWILIO_CONTENT_SID_REMINDER=
TWILIO_CONTENT_SID_CANCELLED=
TWILIO_CONTENT_SID_RESCHEDULED=

# --- Pagos online con Stripe (ver docs/PAGOS.md) ---
# Clave secreta de Stripe. sk_test_… = modo de prueba (no cobra de verdad); sk_live_… = cobros reales.
# Vacía = sin pagos: las reservas se confirman como siempre.
STRIPE_SECRET_KEY=

# --- Worker ---
WORKER_POLL_SECONDS=15
